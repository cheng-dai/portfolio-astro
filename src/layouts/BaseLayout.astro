---
import BaseHead from "../components/BaseHead.astro";
---

<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background: #fcfaf7;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  .skip-link {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 10;
    padding: 8px 12px;
    color: #3d3731;
    background: #fcfaf7;
    border-radius: 4px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
