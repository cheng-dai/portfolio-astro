---
import projectsData from "@/projects.json";
import booksData from "@/books.json";

const allProjects = projectsData.filter((project) => !project.archive);
const currentlyReading = booksData.filter((book) => book.status === "reading");
---

<div class="portfolio">
  <header>
    <a class="home-link" href="/" aria-label="Cheng Dai, home">
      <h1>Cheng Dai</h1>
    </a>
    <p class="role">Software engineer · Stockholm</p>
  </header>

  <main id="main-content">
    <section class="intro" aria-label="About me">
      <p>
        I'm Xucheng Dai,people call me Cheng. I enjoy turning shower thoughts
        into digital tools.
      </p>
    </section>

    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <ul class="project-list">
        {
          allProjects.map((project) => (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                <span class="project-title">{project.name}</span>
                <span class="project-description">
                  {project.shortDescription ?? project.description[0]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="now-heading">
      <h2 id="now-heading">Outside of work</h2>
      <div class="prose">
        <p>
          I run, read, and talk to my cat. Currently training for the Stockholm
          Half Marathon.
        </p>
        {
          currentlyReading.map((book) => (
            <p>
              Reading <span class="book-title">{book.title}</span> by{" "}
              {book.author}.
            </p>
          ))
        }
      </div>
    </section>
  </main>

  <footer id="contact">
    <nav aria-label="Contact and social links">
      <a href="mailto:chengdai.dev@gmail.com">Email</a>
      <a
        href="https://github.com/cheng-dai"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <a
        href="https://www.linkedin.com/in/chengdai/"
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      >
    </nav>
    <p class="copyright">&copy; {new Date().getFullYear()} Xucheng Dai</p>
  </footer>
</div>

<style>
  .portfolio {
    --text-primary: #3d3731;
    --text-secondary: #746c63;
    width: min(100% - 48px, 644px);
    margin-inline: auto;
    padding-block: 88px 48px;
    color: var(--text-primary);
    font-size: 15px;
    line-height: 1.7;
    letter-spacing: -0.012em;
  }

  h1,
  h2,
  p {
    margin: 0;
  }
  h1 {
    font-size: 18px;
    font-weight: 500;
  }
  h2 {
    margin-bottom: 20px;
    font-size: 15px;
    font-weight: 500;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:focus-visible {
    outline: 2px solid #95654b;
    outline-offset: 5px;
    border-radius: 3px;
  }
  .home-link {
    display: inline-block;
  }
  .role {
    color: var(--text-secondary);
    font-size: 14px;
  }
  main {
    display: grid;
    gap: 64px;
    margin-top: 56px;
  }
  .intro,
  .prose {
    display: grid;
    gap: 14px;
    color: var(--text-secondary);
  }
  .project-list {
    display: grid;
    gap: 4px;
    margin: -10px 0;
    padding: 0;
    list-style: none;
  }
  .project-link {
    display: flex;
    flex-direction: column;
    margin-inline: -12px;
    padding: 10px 12px;
    border-radius: 5px;
    transition: background-color 160ms ease;
  }
  .project-link:hover,
  .project-link:focus-visible {
    background: #f2ede6;
  }
  .project-description {
    color: var(--text-secondary);
  }
  .book-title {
    color: var(--text-primary);
  }
  footer {
    margin-top: 64px;
    color: var(--text-secondary);
    font-size: 13px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  nav a {
    padding-block: 10px;
    text-decoration: underline;
    text-decoration-color: #d7ccc0;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }
  nav a:hover {
    color: #95654b;
  }
  .copyright {
    margin-top: 24px;
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .portfolio {
      padding-block: 48px 32px;
    }
    main {
      margin-top: 40px;
      gap: 48px;
    }
    footer {
      margin-top: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
